# =============================================================================
# Meduman backend — environment variables
# Copy to `.env` and fill with real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of THIS backend (used for Paystack callback/webhook URLs).
APP_URL=http://localhost:3000
# Allowed browser origin(s) for CORS — the Vercel frontend. Comma-separated.
# Production always includes https://meduman.sulvatech.com; list additional
# trusted frontend origins here. Do not use wildcards.
FRONTEND_ORIGIN=http://localhost:3001
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (Supabase Postgres) — TWO URLs, do not mix them up
# -----------------------------------------------------------------------------
# Pooled connection (pgbouncer) — used by the RUNTIME Prisma client.
# Must include `?pgbouncer=true&connection_limit=1` for serverless-safe pooling.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used ONLY for `prisma migrate`. Not pooled.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase Auth + Storage
# -----------------------------------------------------------------------------
# Project URL, e.g. https://PROJECT_REF.supabase.co
SUPABASE_URL=
# Service-role key — SERVER ONLY. Full DB/storage access. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/public key — safe for clients; used here only for narrow public ops.
SUPABASE_ANON_KEY=

# --- JWT verification (this backend verifies Supabase-issued JWTs) ---
# Strategy: "jwks" (asymmetric, recommended) or "secret" (legacy HS256).
SUPABASE_JWT_STRATEGY=jwks
# For strategy=jwks: JWKS endpoint (usually <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
# For strategy=secret: the project's legacy JWT secret (HS256 shared secret).
SUPABASE_JWT_SECRET=
# Expected token issuer + audience (validate these on every token).
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Storage ---
# Private bucket for evidence/proof uploads. Files are NEVER publicly readable.
SUPABASE_STORAGE_BUCKET=evidence
# Signed URL lifetime (seconds) for evidence downloads.
SUPABASE_SIGNED_URL_TTL=300

# -----------------------------------------------------------------------------
# Paystack
# -----------------------------------------------------------------------------
# Secret key (sk_test_... / sk_live_...) — SERVER ONLY.
PAYSTACK_SECRET_KEY=
# Public key (pk_test_... / pk_live_...) — safe for the frontend.
PAYSTACK_PUBLIC_KEY=
# Base API url (rarely changed).
PAYSTACK_BASE_URL=https://api.paystack.co
# Webhook signing: Paystack signs webhooks with HMAC-SHA512 of your SECRET key.
# No separate secret is issued — verification uses PAYSTACK_SECRET_KEY above.
# Configure this URL in the Paystack dashboard: <APP_URL>/webhooks/paystack

# -----------------------------------------------------------------------------
# Redis (BullMQ background jobs)
# -----------------------------------------------------------------------------
# Full connection string. On Render, use the internal Redis URL.
REDIS_URL=redis://localhost:6379
# Optional TLS toggle for managed Redis (Render uses rediss:// for TLS).
REDIS_TLS=false
# Prefix to namespace BullMQ queues (avoid collisions across environments).
QUEUE_PREFIX=meduman

# -----------------------------------------------------------------------------
# Release / business config
# -----------------------------------------------------------------------------
# Default auto-release window (hours) for AUTO_AFTER_WINDOW release rule.
AUTO_RELEASE_WINDOW_HOURS=72
# OTP length + TTL (seconds) for buyer confirmation.
OTP_LENGTH=6
OTP_TTL_SECONDS=600
# Server-side secret keying the OTP HMAC hash (min 16 chars). SERVER ONLY.
# Never store the plaintext code — only its keyed hash is persisted.
OTP_HASH_SECRET=
# Max wrong OTP guesses before the code locks and a new one must be issued.
OTP_MAX_ATTEMPTS=5
# EaaS secrets: required on API, worker, and cron. Generate each independently:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across deploys; changing these invalidates API keys or prevents
# decrypting existing webhook secrets. Never use production secrets locally.
# API-key HMAC secret (min 16 characters).
EAAS_API_KEY_SECRET=
# Webhook-secret encryption key (min 32 characters).
EAAS_WEBHOOK_SIGNING_KEY=
# Reject signed-but-stale webhook replays older than this (seconds). Generous by
# default — Paystack legitimately retries over hours; this is a replay backstop.
WEBHOOK_MAX_AGE_SECONDS=86400

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry error tracking DSN. Leave blank to disable (no-op in dev).
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Chat-native bot gateway
# -----------------------------------------------------------------------------
# Telegram bot token from BotFather. Leave blank to disable the Telegram adapter
# entirely — the app still boots with no chat surface registered.
TELEGRAM_BOT_TOKEN=
# Shared secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token; set it when
# registering the webhook. REQUIRED whenever TELEGRAM_BOT_TOKEN is set.
TELEGRAM_WEBHOOK_SECRET=
# Domain for synthetic chat-user emails (chat+<platform>-<id>@<domain>). A chat
# user may have no real email; Supabase Auth still requires one.
CHAT_IDENTITY_EMAIL_DOMAIN=chat.meduman.local
# How long a dialog session stays live between messages (seconds).
CHAT_SESSION_TTL_SECONDS=3600

# Meta chat surfaces — WhatsApp, Instagram DM, Messenger (one Graph app).
# App-level secret + verify token cover all three; each platform also needs its
# own access token + sender id. A platform whose set is incomplete is simply not
# registered (no boot failure). All blank = no Meta surface.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Real OTP transport — WhatsApp Cloud API. The buyer's delivery-confirmation code
# is sent as a PRE-APPROVED authentication template (business-initiated messages
# outside the 24h service window must be templated). The transport is bound only
# when WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID + this template name are
# ALL set; otherwise the log stub stays bound and codes are NOT delivered.
WHATSAPP_OTP_TEMPLATE_NAME=
# Language code of the approved template (e.g. en, en_US). Must match exactly.
WHATSAPP_OTP_TEMPLATE_LANG=en
# Authentication templates have an OTP button (copy-code / one-tap) and the code
# must be repeated in its parameter. Set false only for a button-less template.
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true
# Country code assumed for stored numbers in national form (0803... -> 234803...).
WHATSAPP_DEFAULT_COUNTRY_CODE=234
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# X (Twitter) DMs — slice 3 stub. Set true only to register the placeholder
# adapter; it fails closed until the Account Activity integration is built.
X_ADAPTER_ENABLED=false
