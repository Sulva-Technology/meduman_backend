# =============================================================================
# LOCAL TEST ENVIRONMENT — points at docker-compose.yml services.
# Every value here is fake and local-only. NEVER put a real secret in this file;
# it is committed. Real credentials live in .env (gitignored) or Render.
# =============================================================================

NODE_ENV=test
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3001
LOG_LEVEL=error

# Docker Postgres (host port 55432). No pgbouncer locally, so both URLs match.
DATABASE_URL="postgresql://meduman:meduman@localhost:55432/meduman_test?schema=public"
DIRECT_URL="postgresql://meduman:meduman@localhost:55432/meduman_test?schema=public"

# Supabase — never contacted in tests (auth guard + storage are faked).
SUPABASE_URL=https://local.test.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_JWT_STRATEGY=secret
SUPABASE_JWT_SECRET=test-jwt-secret-not-a-real-one
SUPABASE_JWT_ISSUER=https://local.test.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=evidence
SUPABASE_SIGNED_URL_TTL=300

# Paystack — the e2e harness injects a FakePaystack, so no network call happens.
# This key only has to be a stable string: the fake signs webhooks with it.
PAYSTACK_SECRET_KEY=sk_test_e2e_fake_secret
PAYSTACK_PUBLIC_KEY=pk_test_e2e_fake_public
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SUBACCOUNT_PERCENTAGE_CHARGE=0

# Docker Redis (host port 56379). The money-safety e2e fakes the queue entirely.
REDIS_URL=redis://localhost:56379
REDIS_TLS=false
QUEUE_PREFIX=meduman_test

AUTO_RELEASE_WINDOW_HOURS=72
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_HASH_SECRET=test-otp-hash-secret-at-least-16-chars
OTP_MAX_ATTEMPTS=5
WEBHOOK_MAX_AGE_SECONDS=86400
EAAS_API_KEY_SECRET=test-eaas-api-key-secret-000000
EAAS_WEBHOOK_SIGNING_KEY=test-eaas-webhook-signing-key-0000000000

# Chat gateway — Telegram adapter registered so the chat e2e can exercise it.
# Fake local values; the harness fakes the Supabase admin + queue, so no network.
TELEGRAM_BOT_TOKEN=test-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=test-telegram-webhook-secret
CHAT_IDENTITY_EMAIL_DOMAIN=chat.meduman.test
CHAT_SESSION_TTL_SECONDS=3600

# WhatsApp OTP transport — deliberately NOT enabled here. WHATSAPP_ACCESS_TOKEN
# and WHATSAPP_PHONE_NUMBER_ID stay unset, so NOTIFICATION_SENDER falls back to
# the log stub and no test ever touches the Graph API. The template settings below
# are fake and inert on their own.
WHATSAPP_OTP_TEMPLATE_NAME=test_otp_template
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true
WHATSAPP_DEFAULT_COUNTRY_CODE=234
